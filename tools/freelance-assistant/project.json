{
  "name": "freelance-assistant",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/freelance-assistant",
  "targets": {
    "match": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/freelance-assistant/assistant.py match",
        "cwd": ".",
        "forwardAllArgs": true
      }
    },
    "manual": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/freelance-assistant/assistant.py manual",
        "cwd": ".",
        "forwardAllArgs": true
      }
    },
    "mark-sent": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/freelance-assistant/assistant.py mark-sent",
        "cwd": ".",
        "forwardAllArgs": true
      }
    },
    "quota": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/freelance-assistant/assistant.py quota",
        "cwd": ".",
        "forwardAllArgs": true
      }
    }
  },
  "tags": ["type:tool", "scope:freelance"]
}
