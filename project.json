{
  "name": "portfolio",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "app",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nuxt build",
        "cwd": "."
      },
      "outputs": ["{workspaceRoot}/.vercel/output"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nuxt dev --no-fork --host 0.0.0.0 --port 3000",
        "cwd": "."
      }
    }
  }
}
