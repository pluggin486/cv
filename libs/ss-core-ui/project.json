{
  "name": "ss-core-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ss-core-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config libs/ss-core-ui/vite.config.ts",
        "cwd": "."
      },
      "outputs": ["{workspaceRoot}/libs/ss-core-ui/dist"]
    }
  }
}
